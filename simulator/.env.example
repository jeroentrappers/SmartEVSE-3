# Copy to .env and edit if you need non-defaults.

# MQTT broker (host ports)
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Simulator HTTP (web UI + app's /settings fallback). Use 80 if you want the
# app's HTTP fallback to work without a port; most users leave 8080.
HTTP_PORT=8080

# Simulated device identity
DEVICE_SERIAL=12345
DEVICE_VERSION=v3.13.0-sim

# Simulated charging behaviour
INITIAL_MODE=Smart
MAX_CURRENT_A=32
MIN_CURRENT_A=6
NR_OF_PHASES=3
SIM_TICK_SECONDS=2

# Optional: require auth (leave empty to accept anything, which is what
# Mosquitto will do by default in this repo — the app's real broker
# authenticates, but the simulator is open for ease of use).
MQTT_USERNAME=
MQTT_PASSWORD=
